// Задача из пула: простой граф и обход в ширину (BFS).
//
// Граф задаётся матрицей смежности adj[N][N]: adj[i][j] == 1, если есть
// ребро между вершинами i и j. Граф неориентированный (матрица симметрична).
//
// Структура графа (6 вершин):
//
//        0
//       / \
//      1   2
//      |  / \
//      3 /   4
//       X     \
//      / \     |
//     (3-5)   (4-5)
//
//   рёбра: 0-1, 0-2, 1-3, 2-3, 2-4, 3-5, 4-5
//
// BFS из вершины 0 посещает вершины по слоям расстояния:
//   слой 0: 0
//   слой 1: 1, 2
//   слой 2: 3, 4
//   слой 3: 5

// Размер графа вынесен в константу, чтобы избежать «магических» 6 в типах.
// (язык требует размер массива частью типа, поэтому он фиксирован literal-ом)

// Обход в ширину из вершины start.
// visited — отметка о посещении; queue с индексами head/tail работает как
// кольцевая очередь FIFO поверх массива фиксированного размера.
fn bfs(adj: [[int32; 6]; 6], n: int32, start: int32) {
    let mut visited: [bool; 6]  = [false, false, false, false, false, false];
    let mut queue:   [int32; 6] = [0, 0, 0, 0, 0, 0];
    let mut head: int32 = 0;   // индекс головы очереди (откуда читаем)
    let mut tail: int32 = 0;   // индекс хвоста очереди (куда пишем)

    // помещаем стартовую вершину в очередь
    queue[tail] = start;
    tail = tail + 1;
    visited[start] = true;

    while head < tail {
        // извлекаем очередную вершину из головы очереди
        let v: int32 = queue[head];
        head = head + 1;
        println(v);

        // просматриваем всех соседей v и добавляем непосещённых
        let mut u: int32 = 0;
        while u < n {
            if adj[v][u] == 1 {
                if visited[u] == false {
                    visited[u] = true;
                    queue[tail] = u;
                    tail = tail + 1;
                }
            }
            u = u + 1;
        }
    }
}

fn main() -> int32 {
    // матрица смежности неориентированного графа
    let g: [[int32; 6]; 6] = [
        [0, 1, 1, 0, 0, 0],   // 0 — 1, 2
        [1, 0, 0, 1, 0, 0],   // 1 — 0, 3
        [1, 0, 0, 1, 1, 0],   // 2 — 0, 3, 4
        [0, 1, 1, 0, 0, 1],   // 3 — 1, 2, 5
        [0, 0, 1, 0, 0, 1],   // 4 — 2, 5
        [0, 0, 0, 1, 1, 0],   // 5 — 3, 4
    ];

    bfs(g, 6, 0);   // ожидаемый порядок обхода: 0 1 2 3 4 5
    return 0;
}
