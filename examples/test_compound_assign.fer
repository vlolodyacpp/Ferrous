// A.1.9 — составные присваивания (+= -= *= /= %= &= |= ^= <<= >>=)
struct Point {
    x: int32,
    y: int32,
}

fn main() -> int32 {
    // целочисленные арифметические
    let mut a: int32 = 10;
    a += 5;          // 15
    a -= 2;          // 13
    a *= 3;          // 39
    a /= 4;          // 9
    a %= 5;          // 4
    println(a);      // 4

    // вещественные
    let mut f: float64 = 2.0;
    f += 0.5;        // 2.5
    f *= 4.0;        // 10.0
    println(f);      // 10

    // битовые и сдвиги
    let mut b: int32 = 12;   // 0b1100
    b &= 10;         // 0b1000 = 8
    b |= 1;          // 0b1001 = 9
    b ^= 3;          // 0b1010 = 10
    b <<= 2;         // 40
    b >>= 1;         // 20
    println(b);      // 20

    // поле структуры — адрес вычисляется один раз
    let mut p: Point = Point{x: 1, y: 2};
    p.x += 100;      // 101
    p.y *= 5;        // 10
    println(p.x);    // 101
    println(p.y);    // 10

    // элемент массива
    let mut arr: [int32; 3] = [1, 2, 3];
    arr[1] += 40;    // 42
    arr[2] <<= 3;    // 24
    println(arr[1]); // 42
    println(arr[2]); // 24

    // строковая конкатенация через +=
    let mut s: string = "foo";
    s += "bar";
    println(s);      // foobar

    return 0;
}
