fn main() -> int32 {
    let a: int32 = 12;       // 0b1100
    let b: int32 = 0b1010;   // 10

    println(a & b);   // 8   (0b1000)
    println(a | b);   // 14  (0b1110)
    println(a ^ b);   // 6   (0b0110)
    println(~a);      // -13 (инверсия всех битов)

    println(a << 2);  // 48  (сдвиг влево на 2)
    println(a >> 1);  // 6   (арифметический сдвиг вправо)

    // знаковый сдвиг вправо сохраняет знак (заполнение единицами)
    let neg: int32 = -16;
    println(neg >> 2); // -4

    // беззнаковый сдвиг вправо — логический (заполнение нулями)
    let u: uint32 = 0xFFFFFFFF;
    println(u >> 1);   // 2147483647

    // приоритеты и комбинации с маской битов
    let flags: uint8 = 0b1011;
    println(flags & 0b0010);          // 2   (бит установлен)
    println((flags | 0b0100) ^ 0b0001); // 14

    return 0;
}
