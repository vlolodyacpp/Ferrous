fn fib(n: int32) -> int32 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn add(a: int32, b: int32) -> int32 {
    return a + b;
}

fn add(a: float64, b: float64) -> float64 {
    return a + b;
}

fn add(a: int32, b: int32, c: int32) -> int32 {
    return a + b + c;
}

fn main() -> int32 {
    println(fib(10));       // 55
    println(add(2, 3));     // 5
    println(add(1.5, 2.5)); // 4
    println(add(1, 2, 3));  // 6
    return 0;
}
