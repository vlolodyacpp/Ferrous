fn main() -> int32 {
    let a: int32 = 1;
    println(a << 40);    // 40 & 31 = 8 → 256
    println(a << 32);    // 32 & 31 = 0 → 1
    let b: int32 = 1024;
    println(b >> 33);    // 33 & 31 = 1 → 512

    // беззнаковый логический сдвиг вправо
    let u: uint32 = 4000000000;
    println(u >> 1);     // 2000000000

    let s: int32 = -8;
    println(s >> 1);     // арифметический → -4
    return 0;
}
