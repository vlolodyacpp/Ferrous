fn main() -> int32 {
    let x: int32 = 7;

    if x < 0 {
        println(1);
    } else if x < 10 {
        println(2);
    } else {
        println(3);
    }  // 2

    let mut i: int32 = 0;
    let mut s: int32 = 0;
    while i < 10 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        if i == 8 {
            break;
        }
        s = s + i;
    }
    println(s);   // 1+2+4+5+6+7 = 25
    return 0;
}
