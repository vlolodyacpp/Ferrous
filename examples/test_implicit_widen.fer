fn widen_ret(x: int32) -> int64 { return x; }   // return: int32 → int64

struct Box { v: int64 }

fn main() -> int32 {
    let a: int32 = 5;

    // let: int32 → int64
    let b: int64 = a;
    println(b);                 // 5

    // присваивание: int32 → int64
    let mut m: int64 = 0;
    m = a;
    println(m);                 // 5

    // составное присваивание: RHS int32 → int64
    let mut s: int64 = 10;
    s += a;
    println(s);                 // 15

    // бинарный оператор: int32 + int64 → int64
    let big: int64 = 1000000;
    let c = a + big;
    println(c);                 // 1000005

    // смешение целое+вещественное: int32 + float64 → float64
    let fl: float64 = 2.5;
    let g = a + fl;
    println(g);                 // 7.5

    // return с расширением
    println(widen_ret(a));      // 5

    // элементы массива: int32 → int64
    let arr: [int64; 2] = [a, big];
    println(arr[0]);            // 5
    println(arr[1]);            // 1000000

    // поле структуры: int32 → int64
    let bx: Box = Box { v: a };
    println(bx.v);              // 5

    // сравнение смешанных типов
    if a < big {
        println(1);             // 1
    }

    // float32 → float64
    let f32v: float32 = 1.5f32;
    let wf: float64 = f32v;
    println(wf);                // 1.5

    return 0;
}
