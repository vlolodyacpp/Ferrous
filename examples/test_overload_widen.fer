// A.3.1 — перегрузка функций с неявными приведениями типов

// точное совпадение побеждает любое приведение
fn k(x: int32) -> int32 { return 1; }
fn k(x: int64) -> int32 { return 2; }

// ближайшее расширение: int16 → int32 (cost 11) дешевле int16 → int64 (cost 12)
fn w(x: int32) -> int32 { return 32; }
fn w(x: int64) -> int32 { return 64; }

// целое → вещественное выбирается только когда целых перегрузок нет
fn f(x: float64) -> int32 { return 1000; }

// расширение в реальном вызове меняет ширину аргумента (значение сохраняется)
fn sum(a: int64, b: int64) -> int64 { return a + b; }

fn main() -> int32 {
    // точное: x уже int32 → k(int32)
    let a: int32 = 5;
    println(k(a));          // 1

    // точное для int64
    let b: int64 = 7;
    println(k(b));          // 2

    // int16 → ближайшее расширение int32
    let c: int16 = 3;
    println(w(c));          // 32

    // только float-перегрузка → int32-аргумент расширяется в float64
    let d: int32 = 42;
    println(f(d));          // 1000

    // расширение значений: int16 и int32 → int64 параметры
    let p: int16 = 100;
    let q: int32 = 1000000;
    println(sum(p, q));     // 1000100

    return 0;
}
