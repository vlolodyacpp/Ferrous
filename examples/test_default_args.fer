// A.2.9 — параметры по умолчанию + позиционные/именованные аргументы

// дефолты в хвосте
fn greet(base: int32, step: int32 = 10, scale: int32 = 2) -> int32 {
    return (base + step) * scale;
}

// функция для проверки именованных аргументов и перестановки
fn box(w: int32, h: int32, d: int32 = 1) -> int32 {
    return w * h * d;
}

// перегрузка + дефолт: точная сигнатура без дефолта побеждает дефолтную
fn pick(x: int32) -> int32 { return 100 + x; }
fn pick(x: int32, y: int32 = 5) -> int32 { return x + y; }

// дефолт-литералы разных типов
fn flags(a: bool = true, s: string = "hi") -> string {
    if a { return s; }
    return "off";
}

// отрицательный литерал как дефолт
fn shift(x: int32, by: int32 = -3) -> int32 {
    return x + by;
}

fn main() -> int32 {
    // все дефолты
    println(greet(5));            // (5+10)*2 = 30
    // один переопределён позиционно
    println(greet(5, 1));         // (5+1)*2 = 12
    // оба переопределены
    println(greet(5, 1, 3));      // (5+1)*3 = 18

    // именованный аргумент в хвосте
    println(box(2, 3));           // 2*3*1 = 6
    println(box(2, 3, d=4));      // 2*3*4 = 24
    // именованные с перестановкой
    println(box(h=3, w=2, d=5));  // 2*3*5 = 30
    println(box(2, d=10, h=7));   // 2*7*10 = 140

    // перегрузка: вызов с одним аргументом — берём pick(int32)
    println(pick(1));             // 100 + 1 = 101
    // вызов с двумя — pick(int32,int32)
    println(pick(1, 2));          // 1 + 2 = 3

    // дефолты bool/string
    println(flags());             // "hi"
    println(flags(false));        // "off"
    println(flags(a=true, s="yo"));// "yo"

    // отрицательный дефолт
    println(shift(10));           // 10 + (-3) = 7
    println(shift(10, 5));        // 15

    return 0;
}
