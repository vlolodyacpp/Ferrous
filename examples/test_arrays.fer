fn sm(arr: [int32; 5]) -> int32 {
    let mut i: int32 = 0;
    let mut s: int32 = 0;
    while i < 5 {
        s = s + arr[i]; i = i + 1;
    }
    return s;
}
fn main() -> int32 {
    let mut a: [int32; 5] = [10, 20, 30, 40, 50];
    println(a[0]);
    println(a[4]);   // 10, 50
    a[2] = 99;
    println(a[2]);                  // 99
    println(sm(a));                 // 10+20+99+40+50 = 219
    return 0;
}
